{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Worker result envelope",
  "type": "object",
  "required": [
    "protocol_version", "kind", "id", "work_item", "revision", "contract_id",
    "outcome", "session_ref", "changed_artifacts", "evidence_refs",
    "git_revisions", "affected_work_items"
  ],
  "properties": {
    "protocol_version": {"const": "1.0"},
    "kind": {"const": "worker_result"},
    "id": {"type": "string", "pattern": "^ATT-[0-9]+$"},
    "work_item": {"type": "string", "pattern": "^WI-[0-9]+$"},
    "revision": {"type": "string", "pattern": "^r[1-9][0-9]*$"},
    "contract_id": {"type": "string", "pattern": "^AC-[0-9]+$"},
    "outcome": {"enum": ["SUBMITTED", "BLOCKED", "PENDING_PLAN_REVIEW"]},
    "session_ref": {"type": ["string", "null"]},
    "changed_artifacts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "git_revisions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "affected_work_items": {"type": "array", "items": {"type": "string", "pattern": "^WI-[0-9]+$"}, "uniqueItems": true}
  },
  "additionalProperties": false
}
