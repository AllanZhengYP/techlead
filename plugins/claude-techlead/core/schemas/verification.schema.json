{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Criterion-level verification",
  "type": "object",
  "required": [
    "protocol_version", "kind", "id", "work_item", "revision", "contract_id",
    "method", "criteria", "outcome", "evidence_refs", "verifier_ref"
  ],
  "properties": {
    "protocol_version": {"const": "1.0"},
    "kind": {"const": "verification"},
    "id": {"type": "string", "pattern": "^EV-[0-9]+$"},
    "work_item": {"type": "string", "pattern": "^WI-[0-9]+$"},
    "revision": {"type": "string", "pattern": "^r[1-9][0-9]*$"},
    "contract_id": {"type": "string", "pattern": "^AC-[0-9]+$"},
    "method": {"enum": ["worker_attested", "deterministic", "independent_review", "human_signoff"]},
    "criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^CR-[0-9]+$"}, "uniqueItems": true},
    "outcome": {"enum": ["PASS", "FAIL", "INCONCLUSIVE"]},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "verifier_ref": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
