{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resumable external session",
  "type": "object",
  "required": ["session", "provider", "provider_session_id", "role", "status", "work_items", "workspace_id"],
  "properties": {
    "session": {"type": "string", "pattern": "^SES-[0-9]{3,}$"},
    "provider": {"type": "string", "minLength": 1},
    "provider_session_id": {"type": "string", "minLength": 1},
    "role": {"enum": ["design", "exploration", "implementation", "verification", "techlead-review"]},
    "status": {"enum": ["active", "paused"]},
    "work_items": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^WI-[0-9]{3,}$"}, "uniqueItems": true},
    "workspace_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "git_branch": {"type": "string", "minLength": 1},
    "git_revision": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
