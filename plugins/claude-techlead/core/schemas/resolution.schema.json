{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Revision-specific resolution",
  "type": "object",
  "required": [
    "protocol_version", "kind", "id", "work_item", "revision", "contract_id",
    "verification_ids", "consumed_resolutions", "consumed_assumptions",
    "produced_facts", "affected_artifacts", "git_revisions", "decision_ids"
  ],
  "properties": {
    "protocol_version": {"const": "1.0"},
    "kind": {"const": "resolution"},
    "id": {"type": "string", "pattern": "^RES-[0-9]+$"},
    "work_item": {"type": "string", "pattern": "^WI-[0-9]+$"},
    "revision": {"type": "string", "pattern": "^r[1-9][0-9]*$"},
    "contract_id": {"type": "string", "pattern": "^AC-[0-9]+$"},
    "verification_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^EV-[0-9]+$"}, "uniqueItems": true},
    "consumed_resolutions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "consumed_assumptions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "produced_facts": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "affected_artifacts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "git_revisions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "decision_ids": {"type": "array", "items": {"type": "string", "pattern": "^DEC-[0-9]+$"}, "uniqueItems": true}
  },
  "additionalProperties": false
}
