{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tech Lead project record",
  "type": "object",
  "required": ["protocol_version", "kind"],
  "properties": {
    "protocol_version": {"const": "1.0"},
    "kind": {
      "enum": [
        "project_charter",
        "project_overview",
        "project_frontier",
        "risk_register",
        "decision_register"
      ]
    },
    "current_resolutions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "historical_resolutions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "current_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "resolution_refs"],
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "resolution_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    },
    "work_items": {"type": "array", "items": {"type": "string", "pattern": "^WI-[0-9]+$"}, "uniqueItems": true},
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "owner", "affected_work_items", "mitigation_items", "evidence_refs", "residual_uncertainty"],
        "properties": {
          "id": {"type": "string", "pattern": "^RISK-[0-9]+$"},
          "status": {"enum": ["OPEN", "MONITORING", "MITIGATED", "ACCEPTED", "RETIRED"]},
          "owner": {"type": ["string", "null"]},
          "affected_work_items": {"type": "array", "items": {"type": "string", "pattern": "^WI-[0-9]+$"}, "uniqueItems": true},
          "mitigation_items": {"type": "array", "items": {"type": "string", "pattern": "^WI-[0-9]+$"}, "uniqueItems": true},
          "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "residual_uncertainty": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "resolution_refs", "superseded_by"],
        "properties": {
          "id": {"type": "string", "pattern": "^DEC-[0-9]+$"},
          "status": {"enum": ["GOVERNING", "SUSPENDED", "SUPERSEDED"]},
          "resolution_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "superseded_by": {"type": "array", "items": {"type": "string", "pattern": "^DEC-[0-9]+$"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
