{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable assignment contract",
  "type": "object",
  "required": [
    "protocol_version", "kind", "id", "work_item", "revision", "context_refs",
    "governing_assumptions", "criteria"
  ],
  "properties": {
    "protocol_version": {"const": "1.0"},
    "kind": {"const": "assignment_contract"},
    "id": {"type": "string", "pattern": "^AC-[0-9]+$"},
    "work_item": {"type": "string", "pattern": "^WI-[0-9]+$"},
    "revision": {"type": "string", "pattern": "^r[1-9][0-9]*$"},
    "context_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "governing_assumptions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "methods"],
        "properties": {
          "id": {"type": "string", "pattern": "^CR-[0-9]+$"},
          "methods": {
            "type": "array",
            "minItems": 1,
            "items": {"enum": ["worker_attested", "deterministic", "independent_review", "human_signoff"]},
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
