{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tech Lead project",
  "type": "object",
  "required": ["protocol_version", "project_id", "title", "root_work_item", "workspace_ids"],
  "properties": {
    "protocol_version": {"const": "2.0"},
    "project_id": {"type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"},
    "title": {"type": "string", "minLength": 1},
    "root_work_item": {"type": "string", "pattern": "^WI-[0-9]{3,}$"},
    "workspace_ids": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}, "uniqueItems": true}
  },
  "additionalProperties": false
}
