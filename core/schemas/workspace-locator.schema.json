{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable Tech Lead workspace locator",
  "type": "object",
  "required": ["workspace_id", "project_ids"],
  "properties": {
    "workspace_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "project_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"}, "uniqueItems": true}
  },
  "additionalProperties": false
}
