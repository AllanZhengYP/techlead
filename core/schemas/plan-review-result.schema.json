{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sub-tech-lead plan review result envelope",
  "type": "object",
  "required": [
    "protocol_version", "kind", "id", "work_item", "revision", "contract_id",
    "source_attempt", "outcome", "affected_work_items", "proposed_changes",
    "evidence_refs"
  ],
  "properties": {
    "protocol_version": {"const": "1.0"},
    "kind": {"const": "plan_review_result"},
    "id": {"type": "string", "pattern": "^ATT-[0-9]+$"},
    "work_item": {"type": "string", "pattern": "^WI-[0-9]+$"},
    "revision": {"type": "string", "pattern": "^r[1-9][0-9]*$"},
    "contract_id": {"type": "string", "pattern": "^AC-[0-9]+$"},
    "source_attempt": {"type": "string", "pattern": "^ATT-[0-9]+$"},
    "outcome": {"enum": ["CONTRACT_UNCHANGED", "REVISE", "DECOMPOSE", "REPLACE", "CANCEL", "NEEDS_HUMAN"]},
    "affected_work_items": {"type": "array", "items": {"type": "string", "pattern": "^WI-[0-9]+$"}, "uniqueItems": true},
    "proposed_changes": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": false
}
